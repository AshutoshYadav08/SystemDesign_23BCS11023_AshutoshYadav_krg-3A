        <mxCell id="d7gty-hZnX5AW48Pm6Gb-14" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;h2 data-start=&quot;1284&quot; data-end=&quot;1309&quot;&gt;Core Entities&lt;/h2&gt;&lt;ol data-start=&quot;1311&quot; data-end=&quot;1632&quot;&gt;&lt;li data-start=&quot;1311&quot; data-end=&quot;1355&quot;&gt;&lt;p data-start=&quot;1314&quot; data-end=&quot;1322&quot;&gt;&lt;strong data-start=&quot;1314&quot; data-end=&quot;1322&quot;&gt;User&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1326&quot; data-end=&quot;1355&quot;&gt;&lt;li data-start=&quot;1326&quot; data-end=&quot;1355&quot;&gt;&lt;p data-start=&quot;1328&quot; data-end=&quot;1355&quot;&gt;&lt;code data-start=&quot;1328&quot; data-end=&quot;1355&quot;&gt;userId, name, phone/email&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li data-start=&quot;1357&quot; data-end=&quot;1418&quot;&gt;&lt;p data-start=&quot;1360&quot; data-end=&quot;1369&quot;&gt;&lt;strong data-start=&quot;1360&quot; data-end=&quot;1369&quot;&gt;Order&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1373&quot; data-end=&quot;1418&quot;&gt;&lt;li data-start=&quot;1373&quot; data-end=&quot;1418&quot;&gt;&lt;p data-start=&quot;1375&quot; data-end=&quot;1418&quot;&gt;&lt;code data-start=&quot;1375&quot; data-end=&quot;1418&quot;&gt;orderId, userId, amount, currency, status&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li data-start=&quot;1420&quot; data-end=&quot;1495&quot;&gt;&lt;p data-start=&quot;1423&quot; data-end=&quot;1434&quot;&gt;&lt;strong data-start=&quot;1423&quot; data-end=&quot;1434&quot;&gt;Payment&lt;/strong&gt;&lt;/p&gt;&lt;ul data-start=&quot;1438&quot; data-end=&quot;1495&quot;&gt;&lt;li data-start=&quot;1438&quot; data-end=&quot;1495&quot;&gt;&lt;p data-start=&quot;1440&quot; data-end=&quot;1495&quot;&gt;&lt;code data-start=&quot;1440&quot; data-end=&quot;1495&quot;&gt;paymentId, orderId, amount, method, status, createdAt&lt;/code&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li data-st