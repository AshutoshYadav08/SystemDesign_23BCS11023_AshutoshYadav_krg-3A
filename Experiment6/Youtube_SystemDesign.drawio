        <mxCell id="5NoyTFmbiUV2HVWiRSmj-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1) User clicks video" vertex="1">
