nd-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼk ͼy&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;span&gt;Client → CDN → Thumbnail Proxy → Storage&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;2771&quot; data-end=&quot;2780&quot;&gt;Benefits:&lt;/p&gt;&lt;ul data-start=&quot;2781&quot; data-end=&quot;2826&quot;&gt;&lt;li data-start=&quot;2781&quot; data-end=&quot;2791&quot;&gt;&lt;p data-start=&quot;2783&quot; data-end=&quot;2791&quot;&gt;resizing&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;2792&quot; data-end=&quot;2801&quot;&gt;&lt;p data-start=&quot;2794&quot; data-end=&quot;2801&quot;&gt;caching&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;2802&quot; data-end=&quot;2812&quot;&gt;&lt;p data-start=&quot;2804&quot; data-end=&quot;2812&quot;&gt;security&lt;/p&gt;&lt;/li&gt;&lt;li data-start=&quot;2813&quot; data-end=&quot;2826&quot;&gt;&lt;p data-start=&quot;2815&quot; data-end=&quot;2826&quot;&gt;compression&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h2 data-start=&quot;2833&quot; data-end=&quot;2861&quot;&gt;Step 10 — Metadata Update&lt;/h2&gt;&lt;p data-start=&quot;2863&quot; data-end=&quot;2883&quot;&gt;Metadata DB updated:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2885&quot; data-end=&quot;2964&quot;&gt;&lt;div class=&quot;relative w-full my-4&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼk ͼy&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;div class=&quot;cm-content q9tKkq_readonly&quot;&gt;&lt;span&gt;status = READY&lt;/span&gt;&lt;br&gt;&lt;span&gt;duration&lt;/span&gt;&lt;br&gt;&lt;span&gt;available_qualities&lt;/span&gt;&lt;br&gt;&lt;span&gt;thumbnail_urls&lt;/span&gt;&lt;br&gt;&lt;span&gt;manifest_url&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;2966&quot; data-end=&quot;2987&quot;&gt;Search index updated.&lt;/p&gt;" vertex="1">
